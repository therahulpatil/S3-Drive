# AWS S3 CloudDrive Environment Configuration
# Save this file as '.env' on your production server

# AWS S3 Target Configuration
AWS_BUCKET_NAME=your-s3-bucket-or-access-point-alias
AWS_REGION=ap-south-1

# AWS IAM Credentials (Stored strictly server-side)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE

# Optional Custom Endpoint (MinIO / LocalStack / Cloudflare R2)
# AWS_ENDPOINT=https://s3.custom-provider.com

# Server Port
PORT=5000
